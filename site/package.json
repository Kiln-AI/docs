{
  "name": "kiln-docs-starlight",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "convert": "python3 scripts/gitbook_to_starlight.py",
    "redirects": "python3 scripts/build_redirects.py",
    "redirects:check": "python3 scripts/build_redirects.py --check",
    "verify:redirects": "node scripts/verify_redirects.mjs",
    "test": "npm run test:py && npm run test:js",
    "test:py": "python3 -m unittest discover -s scripts -p 'test_*.py' -t scripts",
    "test:js": "node --test \"scripts/*.test.mjs\"",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "npm run build && astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.4",
    "sharp": "^0.34.4",
    "starlight-llms-txt": "^0.11.0",
    "starlight-theme-black": "^0.7.1"
  }
}
